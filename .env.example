# ==========================================
# Design Platform Monorepo - Environment Config
# ==========================================

# ------------------------------------------
# General / Node Environment
# ------------------------------------------
NODE_ENV=development

# ------------------------------------------
# Applications Configuration
# ------------------------------------------
# apps/web
WEB_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# apps/admin
ADMIN_PORT=3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# apps/super-admin
SUPER_ADMIN_PORT=3002
NEXT_PUBLIC_SUPER_ADMIN_URL=http://localhost:3002

# apps/api
API_HOST=0.0.0.0
API_PORT=4000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# apps/worker
WORKER_CONCURRENCY=5

# ------------------------------------------
# Database (PostgreSQL - Future Phase)
# ------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/design_platform?schema=public

# ------------------------------------------
# Storage (S3 / Cloudflare R2 - Future Phase)
# ------------------------------------------
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=design-platform-assets
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=http://localhost:9000/design-platform-assets

# ------------------------------------------
# Redis / Cache / Queue (Future Phase)
# ------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------
# Authentication (Future Phase)
# ------------------------------------------
AUTH_SECRET=replace_with_a_secure_random_string_in_production
