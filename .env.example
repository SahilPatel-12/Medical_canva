# ==============================================================================
# Design Platform - Environment Variables Template
# VARIABLE NAMES ONLY. Do NOT put secret values in this file.
# Copy this file to .env or .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# Node & Server Environment
# ------------------------------------------------------------------------------
NODE_ENV=
WEB_PORT=
ADMIN_PORT=
SUPER_ADMIN_PORT=
API_HOST=
API_PORT=
CORS_ORIGIN=
WORKER_CONCURRENCY=

# ------------------------------------------------------------------------------
# Public Client Variables (Safe for Browser Bundles)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_ADMIN_URL=
NEXT_PUBLIC_SUPER_ADMIN_URL=
NEXT_PUBLIC_API_URL=

# Supabase Public Configuration (Anon key is restricted by PostgreSQL RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2 Public CDN / Domain for Serving Static Assets
NEXT_PUBLIC_STORAGE_PUBLIC_URL=

# ------------------------------------------------------------------------------
# Server-Only Variables (PRIVATE - NEVER Expose to Browser or NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------

# Supabase Server Credentials
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 Server Credentials (Standard R2 naming)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_REGION=

# Storage Driver Compatibility Aliases (S3 / R2)
STORAGE_DRIVER=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=
